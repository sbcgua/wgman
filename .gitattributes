# Normalize text files in the repository.
* text=auto eol=lf

# Source and documentation
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Windows scripts, if added later
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary/generated artifacts
*.exe binary
*.test binary
*.prof binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
